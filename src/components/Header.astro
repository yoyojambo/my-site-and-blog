			</g>
		  </svg>
		</button>
		<button class="theme-btn" id="td-dark" data-theme="dark" aria-label="Dark theme" title="Dark">
		  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true">
			<path d="M21.64 13a1 1 0 0 0-1.05-.14 8.05 8.05 0 0 1-3.37.73 8.15 8.15 0 0 1-8.14-8.1 8.59 8.59 0 0 1 .25-2A1 1 0 0 0 8 2.36a10.14 10.14 0 1 0 14 11.69 1 1 0 0 0-.36-1.05z"/>
		  </svg>
		</button>
		<button class="theme-btn" id="td-light" data-theme="light" aria-label="Light theme" title="Light">
		  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true">
			<path d="M12 2.25a.75.75 0 01.75.75v2.25a.75.75 0 01-1.5 0V3a.75.75 0 01.75-.75zM7.5 12a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM18.894 6.166a.75.75 0 00-1.06-1.06l-1.591 1.59a.75.75 0 101.06 1.061l1.591-1.59zM21.75 12a.75.75 0 01-.75.75h-2.25a.75.75 0 010-1.5H21a.75.75 0 01.75.75zM17.834 18.894a.75.75 0 001.06-1.06l-1.59-1.591a.75.75 0 10-1.061 1.06l1.59 1.591zM12 18a.75.75 0 01.75.75V21a.75.75 0 01-1.5 0v-2.25A.75.75 0 0112 18zM7.758 17.303a.75.75 0 00-1.061-1.06l-1.591 1.59a.75.75 0 001.06 1.061l1.591-1.59zM6 12a.75.75 0 01-.75.75H3a.75.75 0 010-1.5h2.25A.75.75 0 016 12zM6.697 7.757a.75.75 0 001.06-1.06l-1.59-1.591a.75.75 0 00-1.061 1.06l1.59 1.591z"/>
		  </svg>
		</button>
	  </div>

	  <!-- Mobile theme picker: icon button + dropdown -->
	  <div class="theme-picker-mobile" id="theme-picker-mobile">
		<button
		  class="theme-mobile-trigger"
		  id="theme-mobile-trigger"
		  aria-label="Change theme"
		  aria-haspopup="true"
		  aria-expanded="false"
		  aria-controls="theme-mobile-menu"
		>
		  <!-- Palette icon -->
		  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20" aria-hidden="true">
			<circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/>
			<circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/>
			<circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/>
			<circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/>
			<path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/>
		  </svg>
		</button>
		<div class="theme-mobile-menu" id="theme-mobile-menu" role="radiogroup" aria-label="Select theme" hidden>
		  <button class="theme-mobile-option" data-theme="doom-one" aria-label="Doom One theme">
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1680 869.19995" height="12" width="28" aria-hidden="true">
			  <g transform="translate(-7.1328025,-565.73124)">
				<path d="m 1476.3012,1327.8121 -0.2917,-292.4969 -46.7662,163.4072 -46.7058,-162.6616 -0.2827,222.0343 -152.4945,-114.3724 11.559,-8.6664 -0.5292,-569.30683 144.9467,0.3774 43.4492,152.19623 43.5126,-152.40042 214.4342,0.69673 -70.3645,52.57665 -0.1246,814.42954 z M 78.328958,619.06163 7.1328025,565.73124 l 401.3006875,0.54398 45.93055,35.08717 0.0378,533.50351 12.16772,8.8133 -388.148567,291.252 z m 235.518822,416.21877 -0.15295,-307.89242 -10.75764,-8.78449 -83.44785,0.40375 -0.18291,387.17176 z m 152.39799,82.7814 -0.0717,-516.75483 47.07325,-35.27648 281.69722,-0.0156 46.98005,35.42167 0.17344,597.96244 -133.22444,100.1999 z m 223.12917,-399.76328 -71.04792,0.49268 -11.09868,8.52709 0.15885,308.10291 93.32018,69.9936 0.24947,-377.92826 z m 164.80854,481.66028 -0.34116,-598.79687 46.91876,-35.23879 282.06992,0.26967 47.2183,35.27898 -0.3246,515.55821 -241.33557,182.4526 z m 234.65122,-164.742 -0.03,-308.02638 -11.8726,-9.07298 -70.9365,0.23276 -11.40484,8.78228 0.70414,377.32652 z" style="fill:currentColor;fill-opacity:1;stroke:none"/>
			  </g>
			</svg>
			<span>Doom One</span>
		  </button>
		  <button class="theme-mobile-option" data-theme="dark" aria-label="Dark theme">
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true">
			  <path d="M21.64 13a1 1 0 0 0-1.05-.14 8.05 8.05 0 0 1-3.37.73 8.15 8.15 0 0 1-8.14-8.1 8.59 8.59 0 0 1 .25-2A1 1 0 0 0 8 2.36a10.14 10.14 0 1 0 14 11.69 1 1 0 0 0-.36-1.05z"/>
			</svg>
			<span>Dark</span>
		  </button>
		  <button class="theme-mobile-option" data-theme="light" aria-label="Light theme">
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true">
			  <path d="M12 2.25a.75.75 0 01.75.75v2.25a.75.75 0 01-1.5 0V3a.75.75 0 01.75-.75zM7.5 12a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM18.894 6.166a.75.75 0 00-1.06-1.06l-1.591 1.59a.75.75 0 101.06 1.061l1.591-1.59zM21.75 12a.75.75 0 01-.75.75h-2.25a.75.75 0 010-1.5H21a.75.75 0 01.75.75zM17.834 18.894a.75.75 0 001.06-1.06l-1.59-1.591a.75.75 0 10-1.061 1.06l1.59 1.591zM12 18a.75.75 0 01.75.75V21a.75.75 0 01-1.5 0v-2.25A.75.75 0 0112 18zM7.758 17.303a.75.75 0 00-1.061-1.06l-1.591 1.59a.75.75 0 001.06 1.061l1.591-1.59zM6 12a.75.75 0 01-.75.75H3a.75.75 0 010-1.5h2.25A.75.75 0 016 12zM6.697 7.757a.75.75 0 001.06-1.06l-1.59-1.591a.75.75 0 00-1.061 1.06l1.59 1.591z"/>
			</svg>
			<span>Light</span>
		  </button>
		</div>
	  </div>
	</div>
  </nav>
</header>

<style>
  header {
	margin: 0;
	padding: 0 1em;
	background: var(--theme-bg-component);
	box-shadow: var(--theme-box-shadow);
	transition: background 0.3s ease, box-shadow 0.3s ease;
  }
  
  h2 {
	margin: 0;
	font-size: 1em;
  }

  h2 a,
  h2 a.active {
	text-decoration: none;
	color: var(--theme-text-primary);
  }
  
  nav {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 0.5rem;
	flex-wrap: nowrap;
  }

  nav a {
	padding: 1em 0.5em;
	color: var(--theme-text-primary);
	border-bottom: 4px solid transparent;
	text-decoration: none;
	transition: color 0.3s ease, border-bottom-color 0.3s ease;
  }

  nav a.active {
	text-decoration: none;
	border-bottom-color: var(--accent);
	color: var(--accent);
  }
  
  .internal-links {
	position: absolute;
	left: 50%;
	transform: translateX(-50%);
  }

  /* ── Right side: social + theme ── */
  .right-controls {
	display: flex;
	align-items: center;
	gap: 0.25rem;
	flex-shrink: 0;
  }

  .social-links {
	display: flex;
	gap: 0.1rem;
  }

  .social-links a {
	color: var(--theme-text-primary);
	transition: color 0.3s ease;
	padding: 0.5em;
	display: flex;
	align-items: center;
  }

  .social-links .linkedin:hover { color: #0072b1; }
  .social-links .github:hover   { color: var(--accent-dark); }

  /* Thin vertical divider between social and theme picker */
  .theme-separator {
	width: 1px;
	height: 1.5rem;
	background: var(--theme-border-color);
	margin: 0 0.4rem;
  }

  /* ── Desktop theme picker ── */
  .theme-picker-desktop {
	display: flex;
	align-items: center;
	gap: 2px;
	background: var(--theme-bg-page);
	border: 1px solid var(--theme-border-color);
	border-radius: 8px;
	padding: 3px;
	transition: background 0.3s ease, border-color 0.3s ease;
  }

  .theme-btn {
	background: transparent;
	border: none;
	color: var(--theme-text-secondary);
	width: 2rem;
	height: 2rem;
	border-radius: 6px;
	display: flex;
	align-items: center;
	justify-content: center;
	cursor: pointer;
	transition: background 0.2s ease, color 0.2s ease;
	flex-shrink: 0;
  }

  .theme-btn svg {
	display: block;
  }

  .theme-btn:hover:not(.active) {
	background: var(--theme-border-color);
	color: var(--theme-text-primary);
  }

  .theme-btn.active {
	background: var(--accent);
	color: var(--theme-bg-page);
	cursor: default;
  }

  /* ── Mobile theme picker ── */
  .theme-picker-mobile {
	display: none;
	position: relative;
  }

  .theme-mobile-trigger {
	background: transparent;
	border: 1px solid var(--theme-border-color);
	color: var(--theme-text-primary);
	width: 2.2rem;
	height: 2.2rem;
	border-radius: 8px;
	display: flex;
	align-items: center;
	justify-content: center;
	cursor: pointer;
	transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .theme-mobile-trigger:hover {
	background: var(--theme-border-color);
  }

  .theme-mobile-trigger.menu-open {
	background: var(--accent);
	color: var(--theme-bg-page);
	border-color: var(--accent);
  }

  .theme-mobile-menu {
	position: absolute;
	top: calc(100% + 8px);
	right: 0;
	background: var(--theme-bg-component);
	border: 1px solid var(--theme-border-color);
	border-radius: 10px;
	box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
	overflow: hidden;
	min-width: 140px;
	z-index: 200;
	/* Animation */
	transform-origin: top right;
	animation: dropdown-appear 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .theme-mobile-menu[hidden] {
	display: none;
  }

  @keyframes dropdown-appear {
	from { opacity: 0; transform: scale(0.92) translateY(-6px); }
	to   { opacity: 1; transform: scale(1)   translateY(0);     }
  }

  .theme-mobile-option {
	display: flex;
	align-items: center;
	gap: 0.65rem;
	width: 100%;
	padding: 0.65rem 1rem;
	background: transparent;
	border: none;
	color: var(--theme-text-secondary);
	font-family: inherit;
	font-size: 0.9rem;
	cursor: pointer;
	text-align: left;
	transition: background 0.15s ease, color 0.15s ease;
  }

  .theme-mobile-option:not(:last-child) {
	border-bottom: 1px solid var(--theme-border-color);
  }

  .theme-mobile-option:hover:not(.active) {
	background: var(--theme-border-color);
	color: var(--theme-text-primary);
  }

  .theme-mobile-option.active {
	color: var(--accent);
	font-weight: 600;
  }

  .theme-mobile-option svg {
	flex-shrink: 0;
  }

  /* ── Breakpoints ── */
  @media (max-width: 720px) {
	.social-links         { display: none; }
	.theme-separator      { display: none; }
	.theme-picker-desktop { display: none !important; }
	.theme-picker-mobile  { display: block; }

	/* Keep internal-links nav readable on mobile */
	.internal-links {
	  position: static;
	  transform: none;
	}
  }
</style>

<script>
  const themeCycle = ['doom-one', 'dark', 'light'] as const;
  type Theme = typeof themeCycle[number];
  const htmlEl = document.documentElement;

  // ── Shared state setter ──────────────────────────────────────────
  function setTheme(theme: Theme, animate = true) {
	if (animate) htmlEl.classList.add('theme-transition');
	htmlEl.classList.remove(...themeCycle.map(t => `theme-${t}`));
	htmlEl.classList.add(`theme-${theme}`);
	localStorage.setItem('theme', theme);

	// Update desktop buttons
	document.querySelectorAll<HTMLButtonElement>('.theme-btn').forEach(btn => {
	  const active = btn.dataset.theme === theme;
	  btn.classList.toggle('active', active);
	  btn.setAttribute('aria-pressed', String(active));
	});

	// Update mobile options
	document.querySelectorAll<HTMLButtonElement>('.theme-mobile-option').forEach(btn => {
	  const active = btn.dataset.theme === theme;
	  btn.classList.toggle('active', active);
	  btn.setAttribute('aria-pressed', String(active));
	});

	if (animate) setTimeout(() => htmlEl.classList.remove('theme-transition'), 300);
  }

  // ── Boot ──────────────────────────────────────────────────────────
  const current = (localStorage.getItem('theme') as Theme) || 'doom-one';
  setTheme(current, false);

  // ── Desktop picker ───────────────────────────────────────────────
  document.getElementById('theme-picker-desktop')?.addEventListener('click', e => {
	const btn = (e.target as Element).closest<HTMLButtonElement>('.theme-btn');
	if (btn?.dataset.theme) setTheme(btn.dataset.theme as Theme);
  });

  // ── Mobile picker ────────────────────────────────────────────────
  const trigger  = document.getElementById('theme-mobile-trigger') as HTMLButtonElement | null;
  const menu     = document.getElementById('theme-mobile-menu')    as HTMLElement | null;

  function openMenu() {
	if (!menu || !trigger) return;
	menu.hidden = false;
	trigger.setAttribute('aria-expanded', 'true');
	trigger.classList.add('menu-open');
  }

  function closeMenu() {
	if (!menu || !trigger) return;
	menu.hidden = true;
	trigger.setAttribute('aria-expanded', 'false');
	trigger.classList.remove('menu-open');
  }

  trigger?.addEventListener('click', e => {
	e.stopPropagation();
	menu?.hidden ? openMenu() : closeMenu();
  });

  menu?.addEventListener('click', e => {
	const btn = (e.target as Element).closest<HTMLButtonElement>('.theme-mobile-option');
	if (btn?.dataset.theme) {
	  setTheme(btn.dataset.theme as Theme);
	  closeMenu();
	}
  });

  // Close on outside click
  document.addEventListener('click', () => closeMenu());

  // Close on Escape
  document.addEventListener('keydown', e => {
	if (e.key === 'Escape') closeMenu();
  });
</script>
