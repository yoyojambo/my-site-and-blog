---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
  <nav>
	<div style="display: flex; align-items: center">
	  <!-- padding 10px 0 0 0 to center/align GH avatar with the text -->
	  <a style="border-bottom: 0px; padding: 10px 0 0 0;" href="/"><img src="https://avatars.githubusercontent.com/yoyojambo" alt="yoyojambo's Github avatar" width=40 height=40 /></a>
	  <h2><a href="/">{SITE_TITLE}</a></h2>
	</div>
	<div class="internal-links">
	  <HeaderLink href="/">Home</HeaderLink>
	  <HeaderLink href="/blog">Blog</HeaderLink>
	  <HeaderLink href="/about">About</HeaderLink>
	</div>
	<div class="right-controls">
	  <!-- Social links (hidden on mobile) -->
	  <div class="social-links">
		<a href="https://www.linkedin.com/in/omar-flores-garcia" target="_blank" class="social-icon linkedin">
		  <span class="sr-only">Check me out on LinkedIn</span>
		  <svg viewBox="0 0 16 16" aria-hidden="true" width="28" height="28"
		  ><path
			fill="currentColor"
			d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z"
		  ></path></svg
		  >
		</a>
		<a href="https://github.com/yoyojambo" target="_blank" class="social-icon github">
		  <span class="sr-only">Check out my GitHub</span>
		  <svg viewBox="0 0 16 16" aria-hidden="true" width="28" height="28"
		  ><path
			fill="currentColor"
			d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
		  ></path></svg
		  >
		</a>
	  </div>

	  <!-- Theme separator (desktop only) -->
	  <div class="theme-separator"></div>

	  <!-- Desktop theme picker: inline horizontal pill -->
	  <div class="theme-picker-desktop" id="theme-picker-desktop" role="radiogroup" aria-label="Select theme">
		<button class="theme-btn" id="td-doom-one" data-theme="doom-one" aria-label="Doom One theme" title="Doom One">
		  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1680 869.19995" height="14" width="34" aria-hidden="true">
			<g transform="translate(-7.1328025,-565.73124)">
