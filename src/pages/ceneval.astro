---
import Layout from '../layouts/BlogPost.astro';
---


<Layout
	title="Ceneval EGEL Results"
	description="Omar's Ceneval EGEL results for Higher Education"
	pubDate={new Date('May 16 2026')}
>
	<p>
		These are my official results from
		the <a href="https://ceneval.edu.mx/examenes-egreso-egel/" target="_blank">EGEL</a> national
		evaluation for computer science undergraduates in Mexico.
	</p>

	<div class="pdf-container">
		<embed
			src="/tes_dss_628512638.pdf"
			type="application/pdf"
			width="100%"
			height="800px"
		/>
	</div>

	<div class="pdf-container">
		<embed
			src="/628512638.pdf"
			type="application/pdf"
			width="100%"
			height="800px"
		/>
	</div>

	<p class="pdf-fallback">
		If the PDF does not display correctly, you can <a href="/628512638.pdf"
		target="_blank" rel="noopener noreferrer">download it directly here</a>.
	</p>
</Layout>

<style>
	.pdf-container {
		width: 100%;
		border: 1px solid var(--theme-border, #ccc);
		border-radius: 8px;
		overflow: hidden;
		box-shadow: var(--box-shadow);
		margin: 2em 0 1em 0;
	}
	embed {
		display: block;
		border: none;
	}
	.pdf-fallback {
		text-align: center;
		font-size: 0.9em;
		margin-top: 1em;
	}
</style>

