---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
	<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
	<Header />
	<ThemeToggle />
	<main>
	  <h1>Hey there,</h1>
	  <p>
		Welcome to my page, I'm Omar, a passionate Computer Science student, still at
	    the begginning of my journey and career. When I'm not lazing around I read
	    and learn about low level or Cloud Native systems and anything that catches my eye.
	  </p>
	  
	  <p>
		You can check out some of my projects below, or shoot me an email at
		<a href="mailto:omar@yoyojambo.com">omar@yoyojambo.com</a>.
	  </p>
	  
	</main>
	<Footer />
  </body>
</html>
