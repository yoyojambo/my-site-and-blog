---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
	<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
	<Header />
	<ThemeToggle client:load class="floating-theme-toggle" />
	<main>
	  <h1>Hey there,</h1>
	  <p>
		Welcome to my page, I'm Omar, a CS student passionate about Computer Science, still
	    at the begginning of my journey and career. When I am not lazing around I read and learn
	    about Cloud Native systems.
	  </p>
	  <p>
		This page is themed after my emacs theme, doom-one, but later I'll add some options to
		change it, if you don't like it. I'm very new to frontend development, so this page may take
		a while before it looks even moderately decent, but I am doing my best over here.
	  </p>
	  <p>
		You can check out some of my projects below, or shoot me an email at omar@yoyojambo.com <i>(not
		trying to dox myself here)</i>.
	  </p>

	  
	</main>
	<Footer />
  </body>
</html>
