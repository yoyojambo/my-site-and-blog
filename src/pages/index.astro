---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TechIcons from '../components/TechIcons.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection, render } from 'astro:content';

const projects = await Promise.all((await getCollection('projects')).map(async (project) => {
  const rendered = await render(project);
  return { ...project, Content: rendered.Content };
}));

projects.sort((a, b) => a.data.order - b.data.order);
---

<!doctype html>
<html lang="en">
  <head>
	<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
	<Header />
	<ThemeToggle />
	<main>
	  <section class="intro">
	    <p>
		  I'm Omar Flores. I graduate from CS undergrad @ Tec de Monterrey June 2026,
	      still at the begginning of my journey and career. I'm interested in working
	      close to the OS, distributed systems and data driven applications.
	    </p>
	    
	    <p>
		  You can check out some of my projects below, or shoot me an email at
		  <a href="mailto:omar@yoyojambo.com">omar@yoyojambo.com</a>.
	    </p>

		<p>
		  You can check out some other achievements in
		  the <a href="/about"><i>about</i></a> page.
		</p>
	  </section>

	  <section class="projects">
	    <h2>Projects</h2>
	    <div class="project-grid">
	      {projects.map((project) => (
	        <ProjectCard 
	          {...project.data}
	          Content={project.Content}
	        />
	      ))}
	    </div>
	  </section>

	  <TechIcons />
	  
	</main>
	<Footer />
  </body>
</html>
